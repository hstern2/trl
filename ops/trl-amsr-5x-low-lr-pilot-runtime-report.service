[Unit]
Description=Record AMSR five-traversal low-learning-rate pilot runtime
After=trl-amsr-5x-low-lr-pilot.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /home/ubuntu/trl/ops/record_runtime.py finish --output /home/ubuntu/trl-runs/amsr-5x-low-lr-pilot/runtime.json --journal-unit trl-amsr-5x-low-lr-pilot.service
